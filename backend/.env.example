# CampusConnect backend env — copy to .env and fill in
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/campusconnect?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
CLIENT_URL=http://localhost:5173
MAX_FILE_MB=15
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
